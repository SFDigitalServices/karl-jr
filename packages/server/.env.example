# Wagtail API Configuration
# This should point to the Wagtail admin (used for session validation)
# The proxy will check /pages endpoint to validate the session
WAGTAIL_API_URL=https://api.sf.gov/admin

# Token Authentication Configuration
# TOKEN_SIGNING_SECRET: HS256 JWT signing key for companion API tokens (REQUIRED)
# Generate with: openssl rand -hex 32
# Minimum length: 32 characters (jose uses TextEncoder, so ensure sufficient entropy)
TOKEN_SIGNING_SECRET=your_token_signing_secret_here

# TOKEN_TTL_SECONDS: Token lifetime in seconds (default: 900 = 15 minutes)
# Acceptable range: 300-3600 (5 minutes to 1 hour)
# Shorter values increase security but require more frequent token exchanges
TOKEN_TTL_SECONDS=900

# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
# AIRTABLE_TABLE_NAME: the current table receiving feedback (e.g. "Karl Fillout Data")
AIRTABLE_TABLE_NAME=your_table_name_here
# AIRTABLE_TABLE_NAME_LEGACY (optional): a second, older table to also read from
# (e.g. "Karl data").  When set, the feedback endpoint queries both tables and
# merges the results so historical feedback keeps displaying.  Leave unset to
# read from AIRTABLE_TABLE_NAME only.
AIRTABLE_TABLE_NAME_LEGACY=your_legacy_table_name_here
# AIRTABLE_TABLE_ID / AIRTABLE_TABLE_ID_LEGACY (optional): the Airtable table IDs
# (tbl...) for the current and legacy tables, used to deep-link each feedback
# record to its own source table in the side panel.  These default to the known
# table IDs for base appo4SjothLkSxmbG, so you only need to set them if the
# tables ever change.  Override here if needed.
# AIRTABLE_TABLE_ID=tblpk25gxXFi7bamZ
# AIRTABLE_TABLE_ID_LEGACY=tblbhivrMRm5X8eSU

# Upstash Redis Configuration (automatically provided by Vercel in production)
# UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Optional Configuration (with defaults)
# SESSION_CACHE_TTL=300  # cache TTL in seconds (default: 300)
# WAGTAIL_VALIDATION_TIMEOUT=5000  # validation timeout in milliseconds (default: 5000)

# Cache Configuration (optional)
# SESSION_CACHE_TTL: Time-to-live for cached session validation results in seconds (default: 300 = 5 minutes)
# Acceptable range: 60-3600 (1 minute to 1 hour)
SESSION_CACHE_TTL=300

# WAGTAIL_VALIDATION_TIMEOUT: Timeout for Wagtail session validation requests in milliseconds (default: 5000 = 5 seconds)
# Acceptable range: 1000-10000 (1 second to 10 seconds)
WAGTAIL_VALIDATION_TIMEOUT=5000
